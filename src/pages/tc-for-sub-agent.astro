	<div class="wpb_column vc_column_container vc_col-sm-12"><div class="vc_column-inner vc_custom_1572956457681"><div class="wpb_wrapper  "><div class="vc_row wpb_row vc_inner vc_row-fluid"><div class="wpb_column vc_column_container vc_col-sm-12"><div class="vc_column-inner vc_custom_1572956453094"><div class="wpb_wrapper"><h4 style="text-align: left" class="vc_custom_heading vc_do_custom_heading vc_custom_1586933636802">GENERAL TERMS &amp; CONDITIONS FOR SUB-AGENTS</h4><div class="vc_empty_space" style="height: 30px"><span class="vc_empty_space_inner"></span></div></div></div></div></div><div class="vc_row wpb_row vc_inner vc_row-fluid vc_custom_1572949579309"><div class="ppttxt wpb_column vc_column_container vc_col-sm-12"><div class="vc_column-inner vc_custom_1572960790819"><div class="wpb_wrapper">
